---
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import {
  getAuthor,
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import Link from './Link.astro'


const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const author = await getAuthor(entry.data.author ?? 'snaxcyz')
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<div
  class="hover:bg-secondary/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    class="flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image && (
        <div class="max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="object-cover"
          />
        </div>
      )
    }

    <div class="grow min-w-0">
      <h3 class="mb-1 text-lg font-medium break-words">{entry.data.title}</h3>
      {
        entry.data.description && (
          <p class="text-muted-foreground mb-2 text-sm break-words">{entry.data.description}</p>
        )
      }

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {
          author && (
            <>
              <div class="flex items-center gap-x-1.5">
                {author.avatar ? (
                  <img
                    src={author.avatar}
                    alt={author.name}
                    width="20"
                    height="20"
                    class="size-5 shrink-0 rounded-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span
                    class="bg-muted flex size-5 shrink-0 items-center justify-center rounded-full text-[10px]"
                    aria-hidden="true"
                  >
                    {author.name[0]}
                  </span>
                )}
                <span>{author.name}</span>
              </div>
              <Separator orientation="vertical" className="h-4!" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <Separator orientation="vertical" className="h-4!" />
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" className="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} ta qism
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <Badge variant="secondary" className="flex items-center gap-x-1">
                <Icon name="lucide:hash" class="size-3" />
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
