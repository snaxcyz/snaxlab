---
/**
 * MusicPlayer.astro
 * Ixcham, responsive audio pleyer komponenti.
 * Qo'shiqni onlayn link (masalan .mp3, .wav, yoki to'g'ridan-to'g'ri audio fayl URL) orqali yuklaydi.
 *
 * Ishlatish:
 * ---
 * import MusicPlayer from '../components/MusicPlayer.astro';
 * ---
 * <MusicPlayer
 *   src="https://example.com/song.mp3"
 *   title="XXX."
 *   artist="Kendrick Lamar"
 *   cover="https://example.com/cover.jpg"
 * />
 */

interface Props {
  src: string;
  title: string;
  artist: string;
  cover?: string;
  accent?: string;
}

const {
  src,
  title,
  artist,
  cover,
  accent = "#5EEAD4",
} = Astro.props;

// Har bir sahifada bir nechta pleyer bo'lsa ham to'qnashmasligi uchun unikal id
const uid = `mp-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="mp-player" id={uid} style={`--accent: ${accent};`}>
  <audio class="mp-audio" preload="metadata" src={src}></audio>

  <div class="mp-top">
    <div class="mp-art" data-el="art">
      {cover ? (
        <img src={cover} alt={`${title} — ${artist}`} loading="lazy" />
      ) : (
        <svg viewBox="0 0 24 24" class="mp-note" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.4"/>
          <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      )}
      <span class="mp-bars" data-el="bars" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </span>
    </div>

    <div class="mp-meta">
      <p class="mp-title" title={title}>{title}</p>
      <p class="mp-artist" title={artist}>{artist}</p>

      <div class="mp-seek-row">
        <span class="mp-time" data-el="current">0:00</span>
        <input
          class="mp-seek"
          data-el="seek"
          type="range"
          min="0"
          max="100"
          value="0"
          step="0.1"
          aria-label="Qo'shiq pozitsiyasi"
        />
        <span class="mp-time" data-el="duration">0:00</span>
      </div>
    </div>

    <button class="mp-like" data-el="like" aria-label="Yoqtirish" aria-pressed="false" type="button">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 20.5s-7.5-4.6-10-9.3C.6 8 2 4.5 5.4 3.6c2-.5 4 .3 5.1 2 .3.5.6 1 .8 1.5.2-.5.5-1 .8-1.5 1.1-1.7 3.1-2.5 5.1-2 3.4.9 4.8 4.4 3.4 7.6-2.5 4.7-10 9.3-10 9.3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="mp-controls">
    <button class="mp-btn mp-btn--ghost" data-el="shuffle" aria-label="Aralashtirish" aria-pressed="false" type="button">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M3 6h3.5c1.4 0 2.7.7 3.4 1.9l5.2 8.2c.7 1.2 2 1.9 3.4 1.9H21M3 18h3.5c1.4 0 2.7-.7 3.4-1.9l.5-.8M15.5 6H21m0 0-3-3m3 3-3 3M21 18l-3 3m3-3-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="mp-btn" data-el="prev" aria-label="Oldingi" type="button">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M18 5v14L7 12l11-7Z" fill="currentColor"/><rect x="4" y="5" width="2" height="14" rx="1" fill="currentColor"/></svg>
    </button>
    <button class="mp-btn mp-btn--play" data-el="play" aria-label="Ijro etish" type="button">
      <svg data-el="playIcon" viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/></svg>
      <svg data-el="pauseIcon" viewBox="0 0 24 24" width="20" height="20" fill="none" style="display:none"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
    </button>
    <button class="mp-btn" data-el="next" aria-label="Keyingi" type="button">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M6 5v14l11-7L6 5Z" fill="currentColor"/><rect x="18" y="5" width="2" height="14" rx="1" fill="currentColor"/></svg>
    </button>
    <button class="mp-btn mp-btn--ghost" data-el="repeat" aria-label="Takrorlash" aria-pressed="false" type="button">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M17 2l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="mp-volume-row">
    <button class="mp-vol-btn" data-el="mute" aria-label="Ovozni o'chirish" type="button">
      <svg data-el="volIcon" viewBox="0 0 24 24" width="15" height="15" fill="none"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <svg data-el="muteIcon" viewBox="0 0 24 24" width="15" height="15" fill="none" style="display:none"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="M16 9l4 6M20 9l-4 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    </button>
    <input class="mp-volume" data-el="volume" type="range" min="0" max="100" value="80" aria-label="Ovoz balandligi" />
    <span class="mp-speed" data-el="speed" title="Ijro tezligi" role="button" tabindex="0">1x</span>
  </div>
</div>

<style define:vars={{ accent }}>
  .mp-player {
    --bg: #121215;
    --bg-elev: #1a1a1f;
    --line: rgba(255, 255, 255, 0.08);
    --text: #f3f3f5;
    --text-dim: #9a9aa3;
    --accent: #5eead4;

    width: 100%;
    max-width: 400px;
    margin-inline: auto;
    background: linear-gradient(180deg, var(--bg-elev), var(--bg));
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 14px;
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif;
    box-sizing: border-box;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .mp-player * {
    box-sizing: border-box;
  }

  .mp-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mp-art {
    position: relative;
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    overflow: hidden;
    background: #0c0c0e;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
  }

  .mp-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mp-note {
    width: 22px;
    height: 22px;
    color: var(--text-dim);
  }

  .mp-bars {
    position: absolute;
    inset: 0;
    display: none;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    padding-bottom: 8px;
    background: rgba(0, 0, 0, 0.45);
  }

  .mp-player.is-playing .mp-bars {
    display: flex;
  }

  .mp-bars i {
    display: block;
    width: 2.5px;
    background: var(--accent);
    border-radius: 2px;
    animation: mp-bounce 0.9s ease-in-out infinite;
  }

  .mp-bars i:nth-child(1) { height: 6px; animation-delay: -0.6s; }
  .mp-bars i:nth-child(2) { height: 12px; animation-delay: -0.3s; }
  .mp-bars i:nth-child(3) { height: 8px; animation-delay: -0.9s; }
  .mp-bars i:nth-child(4) { height: 14px; animation-delay: -0.15s; }

  @keyframes mp-bounce {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  .mp-meta {
    flex: 1 1 auto;
    min-width: 0;
  }

  .mp-title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mp-artist {
    margin: 1px 0 0;
    font-size: 12px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mp-seek-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
  }

  .mp-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    color: var(--text-dim);
    flex: 0 0 auto;
    min-width: 28px;
    text-align: center;
  }

  .mp-seek {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--accent) 0%, var(--accent) 0%, var(--line) 0%, var(--line) 100%);
    outline: none;
    cursor: pointer;
  }

  .mp-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .mp-seek::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .mp-seek::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: none;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }

  .mp-like {
    flex: 0 0 auto;
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .mp-like:hover {
    background: var(--line);
    color: var(--text);
  }

  .mp-like[aria-pressed="true"] {
    color: var(--accent);
  }

  .mp-like[aria-pressed="true"] svg path {
    fill: var(--accent);
  }

  .mp-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
  }

  .mp-btn {
    background: none;
    border: none;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: background 0.15s ease, transform 0.1s ease, color 0.15s ease;
  }

  .mp-btn:hover {
    background: var(--line);
  }

  .mp-btn:active {
    transform: scale(0.92);
  }

  .mp-btn--ghost {
    color: var(--text-dim);
  }

  .mp-btn--ghost[aria-pressed="true"] {
    color: var(--accent);
  }

  .mp-btn--play {
    width: 40px;
    height: 40px;
    background: #fff;
    color: #0c0c0e;
  }

  .mp-btn--play:hover {
    background: var(--accent);
  }

  .mp-volume-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .mp-vol-btn {
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    display: flex;
    padding: 4px;
  }

  .mp-vol-btn:hover {
    color: var(--text);
  }

  .mp-volume {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--text-dim) 0%, var(--text-dim) 80%, var(--line) 80%, var(--line) 100%);
    cursor: pointer;
  }

  .mp-volume::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--text);
    cursor: pointer;
  }

  .mp-volume::-moz-range-thumb {
    width: 9px;
    height: 9px;
    border: none;
    border-radius: 50%;
    background: var(--text);
    cursor: pointer;
  }

  .mp-speed {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: var(--text-dim);
    background: var(--line);
    padding: 3px 7px;
    border-radius: 999px;
    cursor: pointer;
    flex: 0 0 auto;
    user-select: none;
  }

  .mp-speed:hover {
    color: var(--text);
  }

  /* Kichik ekranlar uchun (mobil) qo'shimcha siqishlar */
  @media (max-width: 380px) {
    .mp-player {
      padding: 12px;
      border-radius: 14px;
    }
    .mp-art {
      width: 44px;
      height: 44px;
    }
    .mp-title {
      font-size: 13px;
    }
    .mp-btn--play {
      width: 36px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-bars i {
      animation: none;
    }
  }
</style>

<script>
  function formatTime(sec: number): string {
    if (!isFinite(sec) || sec < 0) sec = 0;
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60)
      .toString()
      .padStart(2, "0");
    return `${m}:${s}`;
  }

  function initPlayer(root: HTMLElement) {
    const audio = root.querySelector<HTMLAudioElement>(".mp-audio");
    const playBtn = root.querySelector<HTMLButtonElement>('[data-el="play"]');
    const playIcon = root.querySelector<SVGElement>('[data-el="playIcon"]');
    const pauseIcon = root.querySelector<SVGElement>('[data-el="pauseIcon"]');
    const seek = root.querySelector<HTMLInputElement>('[data-el="seek"]');
    const current = root.querySelector<HTMLElement>('[data-el="current"]');
    const duration = root.querySelector<HTMLElement>('[data-el="duration"]');
    const volume = root.querySelector<HTMLInputElement>('[data-el="volume"]');
    const muteBtn = root.querySelector<HTMLButtonElement>('[data-el="mute"]');
    const volIcon = root.querySelector<SVGElement>('[data-el="volIcon"]');
    const muteIcon = root.querySelector<SVGElement>('[data-el="muteIcon"]');
    const likeBtn = root.querySelector<HTMLButtonElement>('[data-el="like"]');
    const shuffleBtn = root.querySelector<HTMLButtonElement>('[data-el="shuffle"]');
    const repeatBtn = root.querySelector<HTMLButtonElement>('[data-el="repeat"]');
    const speedEl = root.querySelector<HTMLElement>('[data-el="speed"]');

    if (!audio || !playBtn || !seek || !current || !duration || !volume) return;

    let lastVolume = 0.8;
    audio.volume = lastVolume;

    const speeds = [1, 1.25, 1.5, 1.75, 0.5, 0.75];
    let speedIdx = 0;

    function setPlayingState(playing: boolean) {
      root.classList.toggle("is-playing", playing);
      if (playIcon && pauseIcon) {
        playIcon.style.display = playing ? "none" : "block";
        pauseIcon.style.display = playing ? "block" : "none";
      }
      playBtn?.setAttribute("aria-label", playing ? "To'xtatish" : "Ijro etish");
    }

    function updateSeekFill(pct: number) {
      seek.style.background = `linear-gradient(to right, var(--accent) ${pct}%, var(--accent) ${pct}%, var(--line) ${pct}%, var(--line) 100%)`;
    }

    playBtn.addEventListener("click", () => {
      if (audio.paused) {
        audio.play().catch(() => {
          /* autoplay yoki tarmoq xatosi - jim o'tkazamiz */
        });
      } else {
        audio.pause();
      }
    });

    audio.addEventListener("play", () => setPlayingState(true));
    audio.addEventListener("pause", () => setPlayingState(false));
    audio.addEventListener("ended", () => setPlayingState(false));

    audio.addEventListener("loadedmetadata", () => {
      duration.textContent = formatTime(audio.duration);
      seek.max = String(audio.duration || 0);
    });

    audio.addEventListener("timeupdate", () => {
      if (!seek.matches(":active")) {
        seek.value = String(audio.currentTime);
      }
      current.textContent = formatTime(audio.currentTime);
      const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      updateSeekFill(pct);
    });

    seek.addEventListener("input", () => {
      const pct = audio.duration ? (Number(seek.value) / audio.duration) * 100 : 0;
      updateSeekFill(pct);
      current.textContent = formatTime(Number(seek.value));
    });

    seek.addEventListener("change", () => {
      audio.currentTime = Number(seek.value);
    });

    volume.addEventListener("input", () => {
      const v = Number(volume.value) / 100;
      audio.volume = v;
      audio.muted = v === 0;
      volume.style.background = `linear-gradient(to right, var(--text-dim) ${volume.value}%, var(--text-dim) ${volume.value}%, var(--line) ${volume.value}%, var(--line) 100%)`;
      if (v > 0) lastVolume = v;
      updateMuteIcon();
    });

    function updateMuteIcon() {
      const muted = audio.muted || audio.volume === 0;
      if (volIcon && muteIcon) {
        volIcon.style.display = muted ? "none" : "block";
        muteIcon.style.display = muted ? "block" : "none";
      }
    }

    muteBtn?.addEventListener("click", () => {
      if (audio.muted || audio.volume === 0) {
        audio.muted = false;
        audio.volume = lastVolume || 0.8;
        volume.value = String(Math.round(audio.volume * 100));
      } else {
        lastVolume = audio.volume;
        audio.muted = true;
      }
      volume.dispatchEvent(new Event("input"));
    });

    likeBtn?.addEventListener("click", () => {
      const pressed = likeBtn.getAttribute("aria-pressed") === "true";
      likeBtn.setAttribute("aria-pressed", String(!pressed));
    });

    shuffleBtn?.addEventListener("click", () => {
      const pressed = shuffleBtn.getAttribute("aria-pressed") === "true";
      shuffleBtn.setAttribute("aria-pressed", String(!pressed));
    });

    repeatBtn?.addEventListener("click", () => {
      const pressed = repeatBtn.getAttribute("aria-pressed") === "true";
      repeatBtn.setAttribute("aria-pressed", String(!pressed));
      audio.loop = !pressed;
    });

    speedEl?.addEventListener("click", () => {
      speedIdx = (speedIdx + 1) % speeds.length;
      audio.playbackRate = speeds[speedIdx];
      speedEl.textContent = `${speeds[speedIdx]}x`;
    });
    speedEl?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        speedEl.click();
      }
    });

    // Boshlang'ich holatlar
    volume.dispatchEvent(new Event("input"));
    updateSeekFill(0);
  }

  // Sahifadagi barcha pleyerlarni ishga tushiramiz (bir nechta bo'lishi mumkin),
  // Astro view-transitions ishlatilganda ham qayta-qayta init bo'lib ketmasligi uchun belgi qo'yamiz
  function initAll() {
    document.querySelectorAll<HTMLElement>(".mp-player").forEach((el) => {
      if (!el.dataset.mpInit) {
        el.dataset.mpInit = "1";
        initPlayer(el);
      }
    });
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>