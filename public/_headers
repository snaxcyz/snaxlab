/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/admin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-store, no-cache, must-revalidate

/api/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cache-Control: no-store, no-cache, must-revalidate
